# Caddy configuration for hnshowcase.com.
#
# The live file is /etc/caddy/Caddyfile, which holds other sites as well. These
# are the blocks that belong to this project, copied from it as they run; keep
# the two in step. TLS uses a Cloudflare Origin certificate, because the site
# is meant to be reached through Cloudflare.

# CF-Connecting-IP names the visitor only when a request really comes from
# Cloudflare. Anyone can reach this server directly and send that header
# themselves, so for requests from outside Cloudflare's published ranges
# (https://www.cloudflare.com/ips/, checked 2026-11-22) it is replaced with the
# address the request actually came from. Cloudflare never sets X-Real-IP.
(cloudflare_client_ip) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare CF-Connecting-IP {remote_host}
	request_header -X-Real-IP
}

# hnshowcase.com — Next.js app + static screenshots
hnshowcase.com {
	tls /etc/caddy/certs/hnshowcase.com-origin.crt /etc/caddy/certs/hnshowcase.com-origin.key
	encode gzip zstd
	import cloudflare_client_ip
	log {
		output file /var/log/caddy/hnshowcase.com.access.log
	}

	handle /screenshots/* {
		reverse_proxy 127.0.0.1:3334
	}
	handle {
		# Keep CPU-heavy crawlers out of Next.js. The /screenshots/* handle above stays public.
		@blocked_crawlers header_regexp User-Agent (?i)(GPTBot|Bytespider|PetalBot|SemrushBot)
		respond @blocked_crawlers 403
		reverse_proxy 127.0.0.1:3333
	}
}

# www.hnshowcase.com — one address per page: 301 to hnshowcase.com, keeping path and query
www.hnshowcase.com {
	tls /etc/caddy/certs/hnshowcase.com-origin.crt /etc/caddy/certs/hnshowcase.com-origin.key
	redir https://hnshowcase.com{uri} permanent
	log {
		output file /var/log/caddy/www.hnshowcase.com.access.log
	}
}
