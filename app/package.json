    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^0.564.0",
    "next": "^16.3.1",
    "openai": "^6.22.0",
    "playwright": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
