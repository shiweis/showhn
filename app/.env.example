# Database
DATABASE_PATH=./data/showhn.db

# LLM Configuration (for AI analysis pipeline)
# Provider: "openai", "anthropic", or "openrouter"
ANALYSIS_PROVIDER=openai
ANALYSIS_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter/model-specific judging controls. Defaults preserve the
# existing production prompt and provider behavior when these are left blank.
OPENROUTER_PROVIDER=alibaba
ANALYSIS_PROMPT_VARIANT=production
ANALYSIS_STRUCTURED_OUTPUT=false
ANALYSIS_REASONING_EFFORT=
ANALYSIS_TEMPERATURE=
ANALYSIS_ROUTER_REQUIRE_PARAMETERS=false
ANALYSIS_ROUTER_ALLOW_FALLBACKS=false

# Benchmarked MiniMax M3 production settings (do not enable without changing
# ANALYSIS_PROVIDER and ANALYSIS_MODEL above):
# OPENROUTER_PROVIDER=together
# ANALYSIS_PROMPT_VARIANT=minimax-m3-v3
# ANALYSIS_STRUCTURED_OUTPUT=true
# ANALYSIS_REASONING_EFFORT=low
# ANALYSIS_TEMPERATURE=0
# ANALYSIS_ROUTER_REQUIRE_PARAMETERS=true

# Screenshot pipeline
SCREENSHOT_CONCURRENCY=4
SCREENSHOT_TIMEOUT=15000
