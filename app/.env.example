# Database
DATABASE_PATH=./data/showhn.db

# LLM Configuration (for AI analysis pipeline)
# Provider: "openai", "anthropic", or "openrouter"
ANALYSIS_PROVIDER=anthropic
ANALYSIS_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Judging controls for the default Claude Haiku 5.5 profile.
# Effort: low | medium | high | xhigh | max. Thinking: adaptive | disabled.
# Unset leaves the model's own defaults (Haiku 5.5: medium effort, adaptive thinking).
ANALYSIS_ANTHROPIC_EFFORT=medium
# ANALYSIS_ANTHROPIC_THINKING=adaptive
ANALYSIS_PROMPT_VARIANT=production
ANALYSIS_STRUCTURED_OUTPUT=true
# Posts judged per call. On the 208-post reference eval (Nov 2026) batches of
# five matched one per call on tier accuracy, but fewer of their gem/banger
# calls agreed with the reference labels (77% vs 85%). One per call costs about
# $0.79 instead of $0.67 per 1,000 posts with a warm prompt cache.
BATCH_SIZE=1

# OpenRouter-only controls (used when ANALYSIS_PROVIDER=openrouter).
# OPENROUTER_PROVIDER=together
# ANALYSIS_REASONING_EFFORT=low
# ANALYSIS_TEMPERATURE=0
# ANALYSIS_ROUTER_REQUIRE_PARAMETERS=true
# ANALYSIS_ROUTER_ALLOW_FALLBACKS=false

# Screenshot pipeline
SCREENSHOT_CONCURRENCY=4
SCREENSHOT_TIMEOUT=15000

# Where the health check (deploy/cron.sh health) reports, every half hour: this
# address when new posts are arriving and getting verdicts, the same address
# with /fail added when they are not. Meant for a Healthchecks.io check or a
# compatible service, which then emails you on a failure, or when the reports
# stop coming. Treat the address like a password: set it in .env.local only.
# Left empty, the check still writes logs/health.log but tells nobody.
HEALTH_PING_URL=

# HN post ids removed at their author's request, comma-separated. Ingest skips
# them so they are not added again. Set the real ids in .env.local only, so the
# repository does not record who asked to be removed.
REMOVED_POST_IDS=
